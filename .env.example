POSTGRES_DB=shelter
POSTGRES_USER=shelter
POSTGRES_PASSWORD=<set-a-strong-password>
POSTGRES_PORT=5432

DATABASE_URL=jdbc:postgresql://localhost:5432/shelter
DATABASE_USERNAME=shelter
DATABASE_PASSWORD=<same-as-POSTGRES_PASSWORD>

BACKEND_PORT=8080
SHELTER_TIMEZONE=Europe/Bucharest
SHELTER_DOCUMENTS_PATH=./data/documents

SHELTER_ADMIN_USERNAME=admin
SHELTER_ADMIN_DISPLAY_NAME=Shelter Administrator
SHELTER_ADMIN_PASSWORD=<set-a-strong-password>

# Backup location for scripts/backup.sh
BACKUP_DIR=./backups
